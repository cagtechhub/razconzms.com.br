# -----------------------------------------------------------------------------
# Produção (VPS + Traefik + Supabase)
# Copie para `.env` só na OS. Não commitar segredos.
# -----------------------------------------------------------------------------

DOMAIN=razconms.com.br
API_DOMAIN=api.razconms.com.br

# Rede Docker do Traefik (bridge). Nunca use `host`.
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Postgres do Supabase (pooler). Sem serviço `db` no Compose.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Browser / CSP (HTTPS dos domínios reais — não localhost)
NUXT_PUBLIC_API_BASE=https://api.razconms.com.br
NUXT_PUBLIC_SITE_URL=https://razconms.com.br
NUXT_PUBLIC_SITE_NAME=Razcon Soluções Contábeis
NUXT_PUBLIC_NO_INDEX=false
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SSR usa NUXT_API_BASE=http://razconms-backend:3001 (definido no docker-compose).
# Demais NUXT_PUBLIC_* de marketing/SEO (opcional):
# NUXT_PUBLIC_CONTACT_EMAIL=contato@razconms.com.br
# NUXT_PUBLIC_BUSINESS_PHONE=
# NUXT_PUBLIC_BUSINESS_ADDRESS=
# NUXT_PUBLIC_WHATSAPP_NUMBER=
# NUXT_PUBLIC_WHATSAPP_MESSAGE=
# NUXT_PUBLIC_INSTAGRAM_URL=
# NUXT_PUBLIC_FACEBOOK_URL=
# NUXT_PUBLIC_LINKEDIN_URL=
# NUXT_PUBLIC_GA4_MEASUREMENT_ID=
# NUXT_PUBLIC_META_PIXEL_ID=
