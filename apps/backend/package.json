{
  "name": "@razconms/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "yarn workspace @razconms/shared build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@razconms/shared": "file:../../packages/shared",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "express": "^4.21.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@eslint/js": "^9.39.0",
    "@types/express": "^4.17.21",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
